local function add_mise_tools_environment()
  local mise = vim.fn.exepath("mise")
  if mise == "" then
    local local_mise = vim.fn.expand("~/.local/bin/mise")
    if vim.fn.executable(local_mise) == 1 then
      mise = local_mise
    end
  end

  if mise == "" then
    return
  end

  local mise_path = vim.fn.systemlist({
    mise,
    "exec",
    {{ .mise_tools.node | quote }},
    {{- range .mise_tools.dev }}
    {{ . | quote }},
    {{- end }}
    "--",
    "sh",
    "-c",
    "printf '%s' \"$PATH\"",
  })

  if vim.v.shell_error == 0 and #mise_path > 0 and mise_path[1] ~= "" then
    vim.env.PATH = mise_path[1] .. ":" .. vim.env.PATH
  end
end

add_mise_tools_environment()

local node_host = vim.fn.resolve(vim.fn.exepath("neovim-node-host"))
if node_host ~= "" then
  -- mise's aube installer exposes a shell shim; the provider runs its target with node.
  local host_js = vim.fn.fnamemodify(node_host, ":h") .. "/../neovim/bin/cli.js"
  vim.g.node_host_prog = vim.fn.filereadable(host_js) == 1 and host_js or node_host
end

