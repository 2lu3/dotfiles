#!/bin/zsh

{{ if .features.dev }}
if command -v nvim >/dev/null 2>&1; then
    alias v='nvim'
fi
{{ end }}

if command -v lsd >/dev/null 2>&1; then
    alias l='lsd --group-directories-first --color=auto'
    alias ls=l
    alias la='ls -a'
    alias ll='ls -aahl'
    alias lc='clear && ls'
fi

{{ if .features.ai }}
if command -v oco >/dev/null 2>&1; then
    auto() {
        case "$PWD/" in
            */ghq/github.com/2lu3/*)
                git add -A && oco --yes && git push
                ;;
            *)
                printf '%s\n' 'auto can only run under ghq/github.com/2lu3/' >&2
                return 1
                ;;
        esac
    }
fi
{{ end }}
