{{- if .features.ai -}}
#!/bin/sh
set -eu

mise_command=''
if command -v mise >/dev/null 2>&1; then
    mise_command="$(command -v mise)"
elif [ -x "$HOME/.local/bin/mise" ]; then
    mise_command="$HOME/.local/bin/mise"
else
    echo "mise is required for the ai feature." >&2
    exit 1
fi

# Resolve the real binary so cage cannot invoke this wrapper again via PATH.
codex_command="$("$mise_command" which --tool {{ .mise_tools.ai.codex | quote }} codex)"
exec "$mise_command" exec {{ .mise_tools.node | quote }} {{ .mise_tools.ai.codex | quote }} -- cage -config "$HOME/.config/cage/presets.yaml" "$codex_command" "$@"
{{- else -}}
#!/bin/sh
echo "The ai feature is disabled; enable it in chezmoi's configuration to use codex." >&2
exit 1
{{- end }}
