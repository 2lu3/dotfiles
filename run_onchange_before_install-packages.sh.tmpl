#!/bin/bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"
{{ template "brew-shellenv" "bash" }}
export HOMEBREW_NO_ASK=1

SHELL_FEATURE_ENABLED="{{ .features.shell }}"
DEV_FEATURE_ENABLED="{{ .features.dev }}"
AI_FEATURE_ENABLED="{{ .features.ai }}"
GUI_FEATURE_ENABLED="{{ .features.gui }}"

if [ "{{ .chezmoi.os }}" = "linux" ] && [ "$GUI_FEATURE_ENABLED" = "true" ]; then
    echo "The gui feature is only supported on macOS." >&2
    exit 1
fi

if [ "{{ .chezmoi.os }}" = "darwin" ] || [ "$SHELL_FEATURE_ENABLED" = "true" ] || [ "$DEV_FEATURE_ENABLED" = "true" ] || [ "$AI_FEATURE_ENABLED" = "true" ]; then
    if ! command -v brew >/dev/null 2>&1; then
        echo "Homebrew must be installed before applying this configuration: https://brew.sh" >&2
        exit 1
    fi
fi

mkdir -p "$HOME/.local/bin"

install_brew_formula() {
    local formula="$1"

    if ! brew list --formula "$formula" >/dev/null 2>&1; then
        brew install "$formula"
    elif [ "$formula" = "neovim" ]; then
        brew upgrade "$formula"
    fi
}

install_brew_cask() {
    local cask="$1"

    if ! brew list --cask "$cask" >/dev/null 2>&1; then
        brew install --cask "$cask"
    fi
}

case "{{ .chezmoi.os }}" in
    darwin)
        ;;
    linux)
        apt_packages=(
            {{- range .feature_packages.base.linux.apt }}
            {{ . | quote }}
            {{- end }}
            {{- if .features.shell }}
            {{- range .feature_packages.shell.linux.apt }}
            {{ . | quote }}
            {{- end }}
            {{- end }}
            {{- if .features.dev }}
            {{- range .feature_packages.dev.linux.apt }}
            {{ . | quote }}
            {{- end }}
            {{- end }}
        )

        missing_apt_packages=()
        for package in "${apt_packages[@]}"; do
            if [ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != "install ok installed" ]; then
                missing_apt_packages+=("$package")
            fi
        done

        if [ "${#missing_apt_packages[@]}" -gt 0 ]; then
            sudo apt-get update
            sudo apt-get install -y "${missing_apt_packages[@]}"
        fi

        ;;
    *)
        echo "Unsupported operating system: {{ .chezmoi.os }}" >&2
        exit 1
        ;;
esac

{{- range (index .feature_packages.base $.chezmoi.os).brew.formulae }}
install_brew_formula {{ . | quote }}
{{- end }}
{{- if .features.shell }}
{{- range (index .feature_packages.shell $.chezmoi.os).brew.formulae }}
install_brew_formula {{ . | quote }}
{{- end }}
{{- end }}
{{- if .features.dev }}
{{- range (index .feature_packages.dev $.chezmoi.os).brew.formulae }}
install_brew_formula {{ . | quote }}
{{- end }}
{{- end }}
{{- if .features.ai }}
{{- range (index .feature_packages.ai $.chezmoi.os).brew.formulae }}
install_brew_formula {{ . | quote }}
{{- end }}
{{- end }}
{{- if .features.gui }}
{{- range (index .feature_packages.gui $.chezmoi.os).brew.formulae }}
install_brew_formula {{ . | quote }}
{{- end }}
{{- range (index .feature_packages.gui $.chezmoi.os).brew.casks }}
install_brew_cask {{ . | quote }}
{{- end }}
{{- end }}
